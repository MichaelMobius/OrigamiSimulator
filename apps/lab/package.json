{
  "name": "@origami-lab/app",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --open /apps/lab/",
    "build": "vite build --config vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:geometry": "node --experimental-strip-types --test test/*.test.ts",
    "test:smoke": "node test/editor-smoke.mjs",
    "check": "npm run typecheck && npm run test:geometry && npm run build"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "playwright": "1.63.0",
    "typescript": "^5.8.3",
    "vite": "8.3.1"
  }
}
